{
  "name": "lex-corporativo-desktop",
  "private": true,
  "version": "1.0.0-rc.16",
  "description": "Estacion de trabajo juridica desktop con corpus local y API propia del usuario.",
  "author": "Lex Corporativo",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:vault:electron": "node scripts/test-case-vault-electron.mjs",
    "test:recovery:electron": "node scripts/test-recovery-electron.mjs",
    "test:ui:electron": "node scripts/test-ui-electron.mjs",
    "test:release-controls": "node --test tests/release-controls.test.mjs",
    "test:legal-gates": "node scripts/test-legal-gates.mjs",
    "ci:quality": "node scripts/ci-evidence.mjs quality",
    "ci:windows": "node scripts/ci-evidence.mjs windows",
    "verify:embeddings": "node scripts/download-embeddings.mjs --check",
    "verify:embeddings:download": "node scripts/verify-embedding-download.mjs",
    "audit:performance:electron": "node scripts/audit-performance-electron.mjs",
    "audit:cleanup": "node scripts/audit-cleanup-inventory.mjs",
    "audit:data:electron": "node scripts/audit-data-electron.mjs",
    "test:watch": "vitest",
    "predev:electron": "electron-rebuild -f -o better-sqlite3",
    "dev:electron": "node scripts/dev-desktop.mjs",
    "predev:desktop": "electron-rebuild -f -o better-sqlite3",
    "preview:electron": "electron-vite preview",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "dev": "npm run dev:desktop",
    "run:dev": "npm run dev:desktop",
    "build": "electron-vite build",
    "build:analyze": "vite build --config electron.vite.config.ts -m analyze && npx vite-bundle-analyzer out/renderer",
    "prebuild:electron": "npm run audit:corpus-governance:strict && node scripts/generate-ico.mjs && node scripts/download-embeddings.mjs && electron-rebuild -f -o better-sqlite3",
    "build:electron": "npm run build && electron-builder --config electron-builder.config.json --publish never",
    "build:desktop": "npm run build:electron",
    "preflight:release": "node scripts/release-preflight.mjs --target=win",
    "preflight:release:strict": "node scripts/release-preflight.mjs --target=win --strict",
    "audit:legal-knowledge": "node scripts/audit-legal-knowledge.mjs",
    "audit:legal-knowledge:strict": "node scripts/audit-legal-knowledge.mjs --write --strict",
    "audit:legal-retrieval": "node scripts/probe-legal-retrieval.mjs --write",
    "audit:lance-metadata": "node scripts/verify-lance-metadata.mjs --write",
    "index:legal-knowledge": "node scripts/ensure-legal-indices.mjs",
    "eval:legal-rag": "node scripts/evaluate-legal-rag.mjs --write",
    "manifest:legal-corpus": "node scripts/generate-corpus-manifest.mjs --write",
    "audit:corpus-governance": "node scripts/generate-corpus-manifest.mjs --check",
    "audit:corpus-governance:strict": "node scripts/generate-corpus-manifest.mjs --check --strict",
    "stage:fiscal-corpus": "node scripts/stage-official-fiscal-corpus.mjs",
    "stage:fiscal-corpus:download": "node scripts/stage-official-fiscal-corpus.mjs --download",
    "promote:fiscal-corpus": "node scripts/stage-official-fiscal-corpus.mjs --promote",
    "stage:mercantile-corpus": "node scripts/stage-official-mercantile-corpus.mjs",
    "promote:mercantile-corpus": "node scripts/stage-official-mercantile-corpus.mjs --promote",
    "stage:documental-corpus": "node scripts/stage-official-documental-corpus.mjs",
    "stage:documental-corpus:download": "node scripts/stage-official-documental-corpus.mjs --download",
    "promote:documental-corpus": "node scripts/stage-official-documental-corpus.mjs --promote",
    "export:legal-corpus": "node scripts/export-legal-corpus.mjs",
    "repair:legal-anchors": "node scripts/repair-legal-anchors.mjs",
    "ingest:local": "node scripts/ingest-local.mjs",
    "ingest:local:offline": "node scripts/ingest-local.mjs --offline",
    "ingest:local:offline:dry-run": "node scripts/ingest-local.mjs --offline --dry-run"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/petrona": "^5.3.0",
    "@lancedb/lancedb": "^0.31.0",
    "@tailwindcss/typography": "^0.5.20",
    "@xenova/transformers": "^2.17.2",
    "apache-arrow": "^18.1.0",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.5.2",
    "electron": "^42.11.15",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-bundle-analyzer": "^1.3.9",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@xenova/transformers": {
      "onnxruntime-web": "1.26.0"
    },
    "onnxruntime-web": {
      "protobufjs": "7.6.6"
    },
    "@xmldom/xmldom": "0.8.15",
    "dompurify": "3.4.17",
    "js-yaml": "4.3.2",
    "tar": "7.5.22",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "fast-uri": "3.1.8",
    "http-cache-semantics": "4.3.0",
    "source-map-js": "1.2.2",
    "nanoid@3": "3.3.20",
    "browserslist": "4.29.3",
    "baseline-browser-mapping": "2.11.29",
    "undici@6": "6.29.1",
    "undici@7": "7.30.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "sharp@0.33.5": true,
    "sharp@0.32.6": true,
    "onnxruntime-node@1.14.0": true,
    "onnxruntime-node@1.19.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.5": true,
    "protobufjs@7.6.6": true,
    "electron-winstaller@5.4.0": true
  }
}
