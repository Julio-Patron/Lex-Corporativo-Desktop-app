{
  "appId": "mx.lexcorporativo.desktop",
  "asar": true,
  "productName": "Lex Corporativo",
  "artifactName": "Lex-Corporativo-Setup-${version}.${ext}",
  "copyright": "Copyright © 2026 Lex Corporativo",
  "directories": {
    "output": "release",
    "buildResources": "resources"
  },
  "files": [
    "out/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "**/*.node",
    "**/node_modules/@lancedb/**/*",
    "**/node_modules/apache-arrow/**/*"
  ],
  "extraResources": [
    {
      "from": "legal-runtime/models/Xenova/all-MiniLM-L6-v2",
      "to": "legal-runtime/models/Xenova/all-MiniLM-L6-v2",
      "filter": [
        "config.json",
        "tokenizer.json",
        "tokenizer_config.json",
        "onnx/model_quantized.onnx"
      ]
    },
    {
      "from": "legal-runtime/embeddings.lock.json",
      "to": "legal-runtime/embeddings.lock.json"
    },
    {
      "from": "legal-runtime/lance_data",
      "to": "legal-runtime/lance_data"
    },
    {
      "from": "legal-runtime/corpus/corpus-manifest.json",
      "to": "legal-runtime/corpus-manifest.json"
    },
    {
      "from": "legal-runtime/corpus",
      "to": "legal-runtime/corpus",
      "filter": [
        "**/*.md"
      ]
    },
    {
      "from": "resources/THIRD-PARTY-NOTICES.txt",
      "to": "THIRD-PARTY-NOTICES.txt"
    }
  ],
  "win": {
    "target": [
      {
        "arch": [
          "x64"
        ],
        "target": "nsis"
      }
    ],
    "icon": "resources/icon.ico",
    "signAndEditExecutable": true
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Lex Corporativo"
  },
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["x64", "arm64"] }
    ],
    "icon": "resources/icon.icns",
    "category": "public.app-category.business"
  },
  "linux": {
    "target": "AppImage",
    "icon": "resources/icon.png",
    "category": "Office"
  },
  "protocols": {
    "name": "Lex Corporativo",
    "schemes": ["lexcorp"]
  },
  "publish": {
    "provider": "github",
    "owner": "Julio-Patron",
    "repo": "Lex-Corporativo-Desktop-app",
    "releaseType": "release"
  }
}

